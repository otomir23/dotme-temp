---
import avatarImage from "@/assets/avatar.jpg"
import Background from "@/assets/contour-lines.svg"
import PaperclipIllustration from "@/assets/paperclip.svg"
import StampIllustration from "@/assets/stamp.svg"
import BioElement from "@/components/blocks/BioElement.astro"
import Socials from "@/components/blocks/Socials.astro"
---

<div class="border-2 border-border dark:border-border-dark rounded-2xl p-4 relative flex max-xs:flex-col gap-2 bg-surface dark:bg-surface-dark z-0 not-dark:shadow-md shadow-black/5">
    <Background class="absolute -z-10 inset-0 w-full h-full text-foreground/5 dark:text-foreground-dark/10 rounded-2xl" />
    <PaperclipIllustration class="absolute left-4 -top-5.5 z-20 dark:brightness-35" width={29} />
    <img
        src={avatarImage.src}
        class="border-2 border-border dark:border-border-dark rounded-2xl relative size-38 not-dark:shadow-md shadow-black/5 -left-5 -top-4.5 -rotate-6 z-10"
        alt="Green dithered close-up photo of a cat and a clover in a field."
    />
    <Socials />
    <div class="flex flex-col gap-1.5 overflow-hidden">
        <BioElement name="name" icon="ball-pen-fill" isTitle>
            damir modyarov
        </BioElement>
        <BioElement name="bday" icon="cake-2-fill">
            august 23
        </BioElement>
        <BioElement name="residence" icon="map-pin-2-fill">
            moscow, russia
        </BioElement>
        <BioElement name="pronoun" icon="speak-fill">
            they/any
        </BioElement>
        <p class="pt-4 text-sm font-mono text-foreground/25 dark:text-foreground-dark/25 font-semibold">
            {`PNRUSMODYAROV<<DAMIR<OTOMIR23<<<<<<<<<<<<<<<<<<<<<<<<
            2322323230RUS0708236M<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<`}
        </p>
    </div>
    <StampIllustration class="absolute bottom-0 right-0 z-10 opacity-50 dark:brightness-50" />
</div>
