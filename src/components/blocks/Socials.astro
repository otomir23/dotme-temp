---
import Social from "@/components/blocks/Social.astro"
---

<div class="flex items-center text-xl absolute top-0 right-1 xs:right-5 -translate-y-1/2">
     <Social
         href="https://github.com/otomir23"
         class="bg-brand-github rotate-8 translate-x-2.5 translate-y-1.5"
         icon="github-fill"
         name="GitHub"
     />
     <Social
         href="https://t.me/otomir23"
         class="bg-brand-telegram -rotate-6"
         icon="telegram-2-fill"
         name="Telegram"
     />
     <Social
         href="https://steamcommunity.com/id/otomir23"
         class="bg-brand-steam -translate-x-1.5 rotate-6 translate-y-1.5"
         icon="steam-fill"
         name="Steam"
     />
     <Social
         href="https://twitter.com/otomir23"
         class="bg-brand-twitter -translate-x-3 -rotate-4 -translate-y-0.5"
         icon="twitter-fill"
         name="Twitter"
     />
     <Social
         href="https://last.fm/user/otomir"
         class="bg-brand-lastfm -translate-x-5 rotate-12 translate-y-1.5"
         icon="infinity-line"
         name="Last.fm"
     />
 </div>
