---
import ArrowTapeIllustration from "@/assets/arrow-tape.svg"
import WebringLogo from "@/assets/otoring.svg"
import { getFaviconUrl, getWebringData } from "@/data/webring"

const data = await getWebringData()
---

{data && (
    <div class="flex xs:items-center gap-2 font-medium max-xs:flex-col relative py-2 px-4">
        <WebringLogo class="absolute -z-10 top-1/2 left-1/2 -translate-1/2 h-3/4 xs:h-[150%] w-auto dark:invert" />
        <div class="absolute -z-15 top-1/2 left-1/2 -translate-1/2 bg-surface dark:bg-surface-dark ring-surface dark:ring-surface-dark ring-4 h-3/4 aspect-square rounded-full blur-lg" />
        <a href={data.prev.url} class="flex-1 text-start flex items-center gap-1 justify-start">
            <div class="xs:hidden flex-1"><i class="ri-arrow-left-line" /></div>
            <img src={getFaviconUrl(data.prev.favicon)} class="size-4" />
            {data.prev.name}
            <ArrowTapeIllustration width="100%" class="absolute inset-x-0 top-1 -z-20 w-full xs:hidden h-1/3 text-foreground/5 dark:text-foreground-dark/5" />
        </a>
        <a href="https://webring.otomir23.me" target="_blank" class="text-center font-bold not-dark:text-shadow-lg text-shadow-white flex items-center justify-center gap-5">
            otoring
        </a>
        <a href={data.next.url} class="flex-1 text-end flex items-center gap-1 justify-end">
            {data.next.name}
            <img src={getFaviconUrl(data.next.favicon)} class="size-4" />
            <div class="xs:hidden flex-1"><i class="ri-arrow-right-line" /></div>
            <ArrowTapeIllustration width="100%" class="absolute inset-x-0 bottom-1 -z-20 w-full xs:hidden h-1/3 text-foreground/5 dark:text-foreground-dark/5 -scale-100" />
        </a>
    </div>
)}
